{
  // Hosting settings for Cloudflare. The name must match the project name in the Cloudflare dashboard.
  "name": "imissyouboo-and-proseccowithyou",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // The dictionary's little database
  "durable_objects": { "bindings": [{ "name": "DICT", "class_name": "Dictionary" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Dictionary"] }]
}
